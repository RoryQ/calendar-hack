#!/usr/bin/env node
import fs from 'fs';
import yaml from 'js-yaml';
import path from 'path';

const srcPath = 'public/plans/yaml';
const outPath = 'public/plans/json';

if (!fs.existsSync(outPath)) {
    fs.mkdirSync(outPath, { recursive: true });
}

const files = fs.readdirSync(srcPath);

files.forEach(file => {
    if (file.endsWith('.yaml')) {
        const planId = file.slice(0, -5);
        const yamlFilename = path.join(srcPath, file);
        const jsonFilename = path.join(outPath, `${planId}.json`);
        
        console.log(`Converting ${yamlFilename} to ${jsonFilename}`);
        try {
            const yamlDoc = yaml.load(fs.readFileSync(yamlFilename, 'utf8'));
            fs.writeFileSync(jsonFilename, JSON.stringify(yamlDoc, null, 3));
        } catch (e) {
            console.error(`Failed to convert ${yamlFilename}: ${e.message}`);
        }
    }
});
